theory UAV_Recovery_G
begin


builtins: hashing, signing


functions:
    domain_root/2,
    auth_key/4,
    h2s/1


/* ============================================================
   PART A
   M2-LOSS / M2-RECOVER
   ============================================================ */


/* ------------------------------------------------------------
   Initial state:

       UAV = S0
       CS  = S0
       Pi  = bottom
   ------------------------------------------------------------ */

rule M2_Setup:

    let

        kg =
            domain_root(
                ~ku,
                'domain_g'
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    ~pid,
                    'v0',
                    ~cv0
                )
            )

        pk0 =
            pk(sk0)

        rho0 =
            h(
                < 'state',
                  'domain_g',
                  ~pid,
                  'v0',
                  ~cv0,
                  pk0 >
            )

    in

    [
        Fr(~uid),
        Fr(~ku),
        Fr(~pid),
        Fr(~cv0)
    ]

    --[
        M2Setup(
            ~uid,
            rho0
        )
    ]->

    [
        !M2Root(
            ~uid,
            ~ku,
            ~pid
        ),

        M2_UAV_S0(
            ~uid,
            ~cv0,
            pk0,
            rho0
        ),

        M2_CS_S0(
            ~uid,
            ~cv0,
            pk0,
            rho0
        )
    ]



/* ------------------------------------------------------------
   Prepare FIRST authorized mobility event.

   ctx1 abstracts the fresh authenticated TCTX of this event.

   In the full protocol it binds:
       domain
       SID
       PID
       target identity
       epoch
       target ephemeral DH value
   ------------------------------------------------------------ */

rule M2_Prepare_First_Event:

    [
        M2_UAV_S0(
            uid,
            cv0,
            pk0,
            rho0
        ),

        Fr(~sid1),
        Fr(~epoch1),
        Fr(~challenge1)
    ]

    --[
        M2FirstContext(
            uid,
            ~sid1,
            ~epoch1
        )
    ]->

    [
        M2_UAV_Authz1(
            uid,

            cv0,
            pk0,
            rho0,

            ~sid1,
            ~epoch1,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid1,
                  ~epoch1,
                  ~challenge1 >
            )
        ),

        M2_Target_Prepared1(
            uid,

            ~sid1,
            ~epoch1,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid1,
                  ~epoch1,
                  ~challenge1 >
            )
        )
    ]



/* ------------------------------------------------------------
   UAV creates FIRST M1 from committed state S0.
   ------------------------------------------------------------ */

rule M2_First_UAV_M1:

    let

        kg =
            domain_root(
                ku,
                'domain_g'
            )

        cv1 =
            h(
                < 'next',
                  rho0,
                  ctx1,
                  ~u1,
                  'v1' >
            )

        sk1 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v1',
                    cv1
                )
            )

        pk1 =
            pk(sk1)

        rho1 =
            h(
                < 'state',
                  'domain_g',
                  pid,
                  'v1',
                  cv1,
                  pk1 >
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v0',
                    cv0
                )
            )

        authmsg =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid1,
                  epoch1,
                  ctx1,
                  rho0,
                  rho1,
                  pk1 >
            )

        sig1 =
            sign(
                authmsg,
                sk0
            )

    in

    [
        M2_UAV_Authz1(
            uid,

            cv0,
            pk0,
            rho0,

            sid1,
            epoch1,
            ctx1
        ),

        !M2Root(
            uid,
            ku,
            pid
        ),

        Fr(~u1)
    ]

    --[
        FirstM1FromCommitted_M2(
            uid,
            sid1,
            epoch1,
            ctx1,
            rho0,
            rho1
        )
    ]->

    [
        M2_UAV_WaitFirstM2(
            uid,

            cv0,
            pk0,
            rho0,

            sid1,
            epoch1,
            ctx1,

            cv1,
            pk1,
            rho1
        ),

        Out(
            < 'm1_m2case',
              uid,
              sid1,
              epoch1,
              ctx1,

              rho0,
              cv1,
              pk1,
              rho1,

              sig1 >
        )
    ]



/* ------------------------------------------------------------
   Target accepts FIRST M1 and installs Pi.next = S1.

   This models the state after successful first M1
   authentication and target-side pending installation.

   The actual M2 is public and may subsequently be dropped.
   ------------------------------------------------------------ */

rule M2_Target_Install_First_Pending:

    let

        authmsg =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid1,
                  epoch1,
                  ctx1,
                  rho0,
                  rho1,
                  pk1 >
            )

    in

    [
        M2_CS_S0(
            uid,
            cv0,
            pk0,
            rho0
        ),

        M2_Target_Prepared1(
            uid,
            sid1,
            epoch1,
            ctx1
        ),

        In(
            < 'm1_m2case',
              uid,
              sid1,
              epoch1,
              ctx1,

              rho0,
              cv1,
              pk1,
              rho1,

              sig1 >
        )
    ]

    --[
        _restrict(
            verify(
                sig1,
                authmsg,
                pk0
            ) = true
        ),

        PendingInstalled_M2(
            uid,
            rho1
        ),

        FirstM2Produced(
            uid,
            sid1,
            rho1
        )
    ]->

    [
        M2_Infra_Pending(
            uid,

            cv0,
            pk0,
            rho0,

            cv1,
            pk1,
            rho1
        ),

        /*
         * Abstract public M2.
         *
         * The attacker may delete it by simply never
         * delivering it to a UAV In(...) rule.
         */

        Out(
            < 'm2_m2case',
              uid,
              sid1,
              rho1 >
        )
    ]



/* ------------------------------------------------------------
   Previous M2 does NOT cause UAV activation.

   This represents:
       deletion
       excessive delay
       expiry before valid activation

   Hence UAV remains on S0.
   ------------------------------------------------------------ */

rule M2_No_UAV_Activation:

    [
        M2_UAV_WaitFirstM2(
            uid,

            cv0,
            pk0,
            rho0,

            sid1,
            epoch1,
            ctx1,

            cv1,
            pk1,
            rho1
        )
    ]

    --[
        PreviousM2NotActivated(
            uid,
            rho1
        ),

        UAVStillOnCommittedBase(
            uid,
            rho0
        )
    ]->

    [
        M2_UAV_ReadySecond(
            uid,
            cv0,
            pk0,
            rho0
        )
    ]



/* ------------------------------------------------------------
   Prepare a NEW mobility event.

   ctx2 is fresh and distinct from ctx1.

   This is the crucial fix.

   The second UAV authentication can only be generated for this
   new authorized target context.
   ------------------------------------------------------------ */

rule M2_Prepare_Second_Event:

    [
        M2_UAV_ReadySecond(
            uid,
            cv0,
            pk0,
            rho0
        ),

        Fr(~sid2),
        Fr(~epoch2),
        Fr(~challenge2)
    ]

    --[
        M2SecondContext(
            uid,
            ~sid2,
            ~epoch2
        )
    ]->

    [
        M2_UAV_Authz2(
            uid,

            cv0,
            pk0,
            rho0,

            ~sid2,
            ~epoch2,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid2,
                  ~epoch2,
                  ~challenge2 >
            )
        ),

        M2_Target_Prepared2(
            uid,

            ~sid2,
            ~epoch2,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid2,
                  ~epoch2,
                  ~challenge2 >
            )
        )
    ]



/* ------------------------------------------------------------
   SECOND M1.

   UAV still authenticates from committed base S0.

   The signature is bound to:
       SID2
       epoch2
       ctx2
       rho0
       new successor

   Therefore an old M1 cannot be replayed as this M1.
   ------------------------------------------------------------ */

rule M2_Second_UAV_M1:

    let

        kg =
            domain_root(
                ku,
                'domain_g'
            )

        cvnew =
            h(
                < 'next',
                  rho0,
                  ctx2,
                  ~u2,
                  'v1' >
            )

        sknew =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v1',
                    cvnew
                )
            )

        pknew =
            pk(sknew)

        rhonew =
            h(
                < 'state',
                  'domain_g',
                  pid,
                  'v1',
                  cvnew,
                  pknew >
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v0',
                    cv0
                )
            )

        authmsg2 =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid2,
                  epoch2,
                  ctx2,
                  rho0,
                  rhonew,
                  pknew >
            )

        sig2 =
            sign(
                authmsg2,
                sk0
            )

    in

    [
        M2_UAV_Authz2(
            uid,

            cv0,
            pk0,
            rho0,

            sid2,
            epoch2,
            ctx2
        ),

        !M2Root(
            uid,
            ku,
            pid
        ),

        Fr(~u2)
    ]

    --[
        SecondM1FromCommitted(
            uid,
            sid2,
            epoch2,
            ctx2,
            rho0,
            rhonew
        )
    ]->

    [
        Out(
            < 'm1_m2recover',
              uid,
              sid2,
              epoch2,
              ctx2,

              rho0,
              cvnew,
              pknew,
              rhonew,

              sig2 >
        )
    ]



/* ------------------------------------------------------------
   M2Recover.

   Existing:
       CS = S0
       Pi.next = old S1

   New authenticated M1 uses:
       authentication base = CS = S0

   Therefore:
       old pending successor is NOT promoted
       old pending is replaced with the newly authenticated one
   ------------------------------------------------------------ */

rule Target_M2Recover:

    let

        authmsg2 =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid2,
                  epoch2,
                  ctx2,
                  rho0,
                  rhonew,
                  pknew >
            )

    in

    [
        M2_Infra_Pending(
            uid,

            cv0,
            pk0,
            rho0,

            cvold,
            pkold,
            rhoold
        ),

        M2_Target_Prepared2(
            uid,
            sid2,
            epoch2,
            ctx2
        ),

        In(
            < 'm1_m2recover',
              uid,
              sid2,
              epoch2,
              ctx2,

              rho0,
              cvnew,
              pknew,
              rhonew,

              sig2 >
        )
    ]

    --[
        _restrict(
            verify(
                sig2,
                authmsg2,
                pk0
            ) = true
        ),

        M2Recover(
            uid,
            rho0,
            rhoold,
            rhonew
        )
    ]->

    [
        /*
         * CS remains rho0.
         * old Pi is consumed.
         * newly authenticated successor becomes new Pi.
         */

        M2_AfterRecover(
            uid,
            rho0,
            rhonew
        )
    ]



/* ============================================================
   PART B
   M3-LOSS / M3-RECOVER
   ============================================================ */


/* ------------------------------------------------------------
   Initial state.
   ------------------------------------------------------------ */

rule M3_Setup:

    let

        kg =
            domain_root(
                ~ku,
                'domain_g'
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    ~pid,
                    'v0',
                    ~cv0
                )
            )

        pk0 =
            pk(sk0)

        rho0 =
            h(
                < 'state',
                  'domain_g',
                  ~pid,
                  'v0',
                  ~cv0,
                  pk0 >
            )

        pkt =
            pk(~skt)

    in

    [
        Fr(~uid),
        Fr(~ku),
        Fr(~pid),
        Fr(~cv0),
        Fr(~skt)
    ]

    --[
        M3Setup(
            ~uid,
            rho0
        )
    ]->

    [
        !M3Root(
            ~uid,
            ~ku,
            ~pid
        ),

        !M3TargetKey(
            ~uid,
            ~skt,
            pkt
        ),

        M3_UAV_S0(
            ~uid,
            ~cv0,
            pk0,
            rho0
        ),

        M3_CS_S0(
            ~uid,
            ~cv0,
            pk0,
            rho0
        )
    ]



/* ------------------------------------------------------------
   Fresh first mobility context.
   ------------------------------------------------------------ */

rule M3_Prepare_First_Event:

    [
        M3_UAV_S0(
            uid,
            cv0,
            pk0,
            rho0
        ),

        Fr(~sid1),
        Fr(~epoch1),
        Fr(~challenge1)
    ]

    --[
        M3FirstContext(
            uid,
            ~sid1,
            ~epoch1
        )
    ]->

    [
        M3_UAV_Authz1(
            uid,

            cv0,
            pk0,
            rho0,

            ~sid1,
            ~epoch1,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid1,
                  ~epoch1,
                  ~challenge1 >
            )
        ),

        M3_Target_Prepared1(
            uid,

            ~sid1,
            ~epoch1,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid1,
                  ~epoch1,
                  ~challenge1 >
            )
        )
    ]



/* ------------------------------------------------------------
   First UAV M1 from S0.
   ------------------------------------------------------------ */

rule M3_First_UAV_M1:

    let

        kg =
            domain_root(
                ku,
                'domain_g'
            )

        cv1 =
            h(
                < 'next',
                  rho0,
                  ctx1,
                  ~u1,
                  'v1' >
            )

        sk1 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v1',
                    cv1
                )
            )

        pk1 =
            pk(sk1)

        rho1 =
            h(
                < 'state',
                  'domain_g',
                  pid,
                  'v1',
                  cv1,
                  pk1 >
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v0',
                    cv0
                )
            )

        authmsg =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid1,
                  epoch1,
                  ctx1,
                  rho0,
                  rho1,
                  pk1 >
            )

        sig1 =
            sign(
                authmsg,
                sk0
            )

    in

    [
        M3_UAV_Authz1(
            uid,

            cv0,
            pk0,
            rho0,

            sid1,
            epoch1,
            ctx1
        ),

        !M3Root(
            uid,
            ku,
            pid
        ),

        Fr(~u1)
    ]

    --[
        FirstM1FromCommitted_M3(
            uid,
            sid1,
            epoch1,
            ctx1,
            rho0,
            rho1
        )
    ]->

    [
        M3_UAV_WaitM2(
            uid,

            sid1,
            epoch1,
            ctx1,

            cv1,
            pk1,
            rho1
        ),

        Out(
            < 'm1_m3case',
              uid,
              sid1,
              epoch1,
              ctx1,

              rho0,
              cv1,
              pk1,
              rho1,

              sig1 >
        )
    ]



/* ------------------------------------------------------------
   Target installs Pi.next = S1 and sends authenticated M2.

   The signature here is a symbolic abstraction of the
   authenticated target-confirmation value from the full model.
   ------------------------------------------------------------ */

rule M3_Target_Send_M2:

    let

        authmsg =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid1,
                  epoch1,
                  ctx1,
                  rho0,
                  rho1,
                  pk1 >
            )

        m2body =
            h(
                < 'target_confirm',
                  uid,
                  sid1,
                  epoch1,
                  ctx1,
                  rho1 >
            )

        m2sig =
            sign(
                m2body,
                skt
            )

    in

    [
        M3_CS_S0(
            uid,
            cv0,
            pk0,
            rho0
        ),

        M3_Target_Prepared1(
            uid,
            sid1,
            epoch1,
            ctx1
        ),

        !M3TargetKey(
            uid,
            skt,
            pkt
        ),

        In(
            < 'm1_m3case',
              uid,
              sid1,
              epoch1,
              ctx1,

              rho0,
              cv1,
              pk1,
              rho1,

              sig1 >
        )
    ]

    --[
        _restrict(
            verify(
                sig1,
                authmsg,
                pk0
            ) = true
        ),

        PendingInstalled_M3(
            uid,
            rho1
        )
    ]->

    [
        M3_Infra_Pending(
            uid,

            cv0,
            pk0,
            rho0,

            cv1,
            pk1,
            rho1
        ),

        Out(
            < 'm2_m3case',
              uid,
              sid1,
              epoch1,
              ctx1,
              rho1,
              m2sig >
        )
    ]



/* ------------------------------------------------------------
   UAV accepts M2 and activates S1.

   M3 is made public.
   The adversary may delete it, so infrastructure remains:
       CS = S0
       Pi.next = S1
   ------------------------------------------------------------ */

rule M3_UAV_Activate:

    let

        m2body =
            h(
                < 'target_confirm',
                  uid,
                  sid1,
                  epoch1,
                  ctx1,
                  rho1 >
            )

    in

    [
        M3_UAV_WaitM2(
            uid,

            sid1,
            epoch1,
            ctx1,

            cv1,
            pk1,
            rho1
        ),

        !M3TargetKey(
            uid,
            skt,
            pkt
        ),

        In(
            < 'm2_m3case',
              uid,
              sid1,
              epoch1,
              ctx1,
              rho1,
              m2sig >
        )
    ]

    --[
        _restrict(
            verify(
                m2sig,
                m2body,
                pkt
            ) = true
        ),

        UAVActivatePending(
            uid,
            rho1
        ),

        M3MayBeLost(
            uid,
            rho1
        )
    ]->

    [
        M3_UAV_S1(
            uid,
            cv1,
            pk1,
            rho1
        ),

        /*
         * Public M3.
         *
         * No target rule consumes this message in the
         * loss-recovery branch: the attacker drops it.
         */

        Out(
            < 'm3_m3case',
              uid,
              sid1,
              rho1 >
        )
    ]



/* ------------------------------------------------------------
   Prepare a NEW authorized event after UAV has activated S1.

   New ctx2 prevents replay of the previous M1.
   ------------------------------------------------------------ */

rule M3_Prepare_Second_Event:

    [
        M3_UAV_S1(
            uid,
            cv1,
            pk1,
            rho1
        ),

        Fr(~sid2),
        Fr(~epoch2),
        Fr(~challenge2)
    ]

    --[
        M3SecondContext(
            uid,
            ~sid2,
            ~epoch2
        )
    ]->

    [
        M3_UAV_Authz2(
            uid,

            cv1,
            pk1,
            rho1,

            ~sid2,
            ~epoch2,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid2,
                  ~epoch2,
                  ~challenge2 >
            )
        ),

        M3_Target_Prepared2(
            uid,

            ~sid2,
            ~epoch2,

            h(
                < 'mobility_context',
                  'domain_g',
                  uid,
                  ~sid2,
                  ~epoch2,
                  ~challenge2 >
            )
        )
    ]



/* ------------------------------------------------------------
   UAV authenticates second event from S1 = Pi.next.

   It proposes successor S2.
   ------------------------------------------------------------ */

rule M3_Second_UAV_M1:

    let

        kg =
            domain_root(
                ku,
                'domain_g'
            )

        sk1 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v1',
                    cv1
                )
            )

        cv2 =
            h(
                < 'next',
                  rho1,
                  ctx2,
                  ~u2,
                  'v2' >
            )

        sk2 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v2',
                    cv2
                )
            )

        pk2 =
            pk(sk2)

        rho2 =
            h(
                < 'state',
                  'domain_g',
                  pid,
                  'v2',
                  cv2,
                  pk2 >
            )

        authmsg2 =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid2,
                  epoch2,
                  ctx2,
                  rho1,
                  rho2,
                  pk2 >
            )

        sig2 =
            sign(
                authmsg2,
                sk1
            )

    in

    [
        M3_UAV_Authz2(
            uid,

            cv1,
            pk1,
            rho1,

            sid2,
            epoch2,
            ctx2
        ),

        !M3Root(
            uid,
            ku,
            pid
        ),

        Fr(~u2)
    ]

    --[
        SecondM1FromPending(
            uid,
            sid2,
            epoch2,
            ctx2,
            rho1,
            rho2
        )
    ]->

    [
        Out(
            < 'm1_m3recover',
              uid,
              sid2,
              epoch2,
              ctx2,

              rho1,
              cv2,
              pk2,
              rho2,

              sig2 >
        )
    ]



/* ------------------------------------------------------------
   M3Recover.

   Infrastructure:
       CS = S0
       Pi.next = S1

   New M1 authenticates under S1 public key.

   Therefore:
       S1 is first promoted
       S2 becomes the newly authenticated pending successor
   ------------------------------------------------------------ */

rule Target_M3Recover:

    let

        authmsg2 =
            h(
                < 'uav_auth',
                  'domain_g',
                  uid,
                  sid2,
                  epoch2,
                  ctx2,
                  rho1,
                  rho2,
                  pk2 >
            )

    in

    [
        M3_Infra_Pending(
            uid,

            cv0,
            pk0,
            rho0,

            cv1,
            pk1,
            rho1
        ),

        M3_Target_Prepared2(
            uid,
            sid2,
            epoch2,
            ctx2
        ),

        In(
            < 'm1_m3recover',
              uid,
              sid2,
              epoch2,
              ctx2,

              rho1,
              cv2,
              pk2,
              rho2,

              sig2 >
        )
    ]

    --[
        _restrict(
            verify(
                sig2,
                authmsg2,
                pk1
            ) = true
        ),

        PromotePending(
            uid,
            rho1
        ),

        M3Recover(
            uid,
            rho1,
            rho2
        )
    ]->

    [
        M3_AfterRecover(
            uid,

            rho1,
            rho2
        )
    ]



/* ============================================================
   EXECUTABILITY
   ============================================================ */


lemma m2_recover_executable:
    exists-trace
    "
        Ex uid base oldpending newpending #i.

            M2Recover(
                uid,
                base,
                oldpending,
                newpending
            ) @ i
    "


lemma m3_recover_executable:
    exists-trace
    "
        Ex uid oldpending newpending #i.

            M3Recover(
                uid,
                oldpending,
                newpending
            ) @ i
    "



/* ============================================================
   M2 RECOVERY PROPERTIES
   ============================================================ */


/*
 * This is the corrected version of the lemma that failed.
 *
 * M2Recover must be based on an actual second M1 generated
 * from the still-committed state.
 */

lemma m2_recover_uses_committed_base:
    "
        All uid base oldpending newpending #i.

            M2Recover(
                uid,
                base,
                oldpending,
                newpending
            ) @ i

        ==>

            (
                Ex sid epoch ctx #j.

                    SecondM1FromCommitted(
                        uid,
                        sid,
                        epoch,
                        ctx,
                        base,
                        newpending
                    ) @ j

                & j < i
            )
    "



/*
 * The previous target confirmation did not activate the UAV.
 */

lemma m2_recover_after_no_activation:
    "
        All uid base oldpending newpending #i.

            M2Recover(
                uid,
                base,
                oldpending,
                newpending
            ) @ i

        ==>

            (
                Ex #j.

                    PreviousM2NotActivated(
                        uid,
                        oldpending
                    ) @ j

                & j < i
            )
    "



/*
 * M2Recover must not promote the old pending successor.
 */

lemma m2_recover_no_old_promotion:
    "
        All uid base oldpending newpending #i.

            M2Recover(
                uid,
                base,
                oldpending,
                newpending
            ) @ i

        ==>

            not (
                Ex #j.

                    PromotePending(
                        uid,
                        oldpending
                    ) @ j
            )
    "



/* ============================================================
   M3 RECOVERY PROPERTIES
   ============================================================ */


/*
 * M3Recover must authenticate from the previous pending state.
 */

lemma m3_recover_uses_pending_base:
    "
        All uid oldpending newpending #i.

            M3Recover(
                uid,
                oldpending,
                newpending
            ) @ i

        ==>

            (
                Ex sid epoch ctx #j.

                    SecondM1FromPending(
                        uid,
                        sid,
                        epoch,
                        ctx,
                        oldpending,
                        newpending
                    ) @ j

                & j < i
            )
    "



/*
 * The old pending state must already have been activated
 * at the UAV.
 */

lemma m3_recover_requires_uav_activation:
    "
        All uid oldpending newpending #i.

            M3Recover(
                uid,
                oldpending,
                newpending
            ) @ i

        ==>

            (
                Ex #j.

                    UAVActivatePending(
                        uid,
                        oldpending
                    ) @ j

                & j < i
            )
    "



/*
 * The promoted state must be exactly the previously installed
 * pending successor.
 */

lemma m3_recover_promotes_previous_pending:
    "
        All uid oldpending newpending #i.

            M3Recover(
                uid,
                oldpending,
                newpending
            ) @ i

        ==>

            (
                PromotePending(
                    uid,
                    oldpending
                ) @ i

              &

                Ex #j.

                    PendingInstalled_M3(
                        uid,
                        oldpending
                    ) @ j

                & j < i
            )
    "


end
