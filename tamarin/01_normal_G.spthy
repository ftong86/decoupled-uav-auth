theory UAV_Normal_G
begin


/* ============================================================
   01_normal_G.spthy

   Purpose:
   Verify ONE normal communication-domain authentication
   transaction:

       P_G -> M1_G -> M2_G -> M3_G -> Commit

   This first model is deliberately acyclic.

   It does NOT yet model:
       - M2Recover
       - M3Recover
       - domain E
       - key compromise
       - repeated state evolution

   ============================================================ */


builtins: hashing, signing, diffie-hellman


/* ============================================================
   Abstract cryptographic constructions
   ============================================================ */

functions:
    domain_root/2,
    auth_key/4,
    h2s/1,
    hkdf_extract/2,
    hkdf_expand/2,
    mac/2


/* ============================================================
   Restrict this staging model to one trusted setup.

   This prevents multiple independent registrations from
   obscuring the first Normal-session verification.
   ============================================================ */

restriction OnlyOneSetup:
    "All #i #j.
        OnlyOnce() @ i
        & OnlyOnce() @ j
        ==> #i = #j"



/* ============================================================
   RULE 1
   Trusted registration / enrollment

   Abstracts:
       CA_G
       target long-term signing key
       PUF-derived UAV master root
       PID_G
       initial state S_G,0

   PUF physical noise is NOT modeled here.

   ~ku represents the uncompromised PUF-reconstructable root.
   ============================================================ */

rule Setup_G:

    let

        pkca =
            pk(~skca)

        pkt =
            pk(~skt)

        kg =
            domain_root(
                ~ku,
                'domain_g'
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    ~pid,
                    'v0',
                    ~cv0
                )
            )

        pk0 =
            pk(sk0)

        rho0 =
            h(
                < 'state',
                  'domain_g',
                  ~pid,
                  'v0',
                  ~cv0,
                  pk0 >
            )

        certbody =
            h(
                < 'cert',
                  'domain_g',
                  'target',
                  pkt >
            )

        certsig =
            sign(
                certbody,
                ~skca
            )

    in

    [
        Fr(~skca),
        Fr(~skt),
        Fr(~ku),
        Fr(~pid),
        Fr(~cv0)
    ]

    --[
        OnlyOnce()
    ]->

    [
        /* Trusted G-domain CA */
        !CA_G(pkca),

        /* Target long-term credential */
        !TargetCred_G(
            ~skt,
            pkt,
            certsig
        ),

        /* UAV hardware-rooted credential source */
        !UAVRoot_G(
            ~ku,
            ~pid
        ),

        /* PID delivered to target over trusted control plane */
        !PID_G(~pid),

        /*
         * IMPORTANT:
         * These are staging facts for the single Normal run.
         * They will NOT be recreated after completion.
         */

        UAVInitial_G(
            ~cv0,
            pk0,
            rho0
        ),

        CSInitial_G(
            ~cv0,
            pk0,
            rho0
        ),

        StartNormal_G(),

        /* Public values */
        Out(pkca),
        Out(pkt),
        Out(pk0),
        Out(~pid)
    ]



/* ============================================================
   RULE 2
   Target creates P_G

   Paper:
       SID_G <- random
       x_T   <- random
       X_T   = g^x_T

       TCTX_G
       PreAuth_G
       P_G

   xtsec = x_T
   xtpub = X_T
   ============================================================ */

rule Target_Prepare_P:

    let

        xtpub =
            'g' ^ ~xtsec

        tctx =
            h(
                < 'tctx',
                  'domain_g',
                  ~sid,
                  pid,
                  'target',
                  ~epoch,
                  xtpub >
            )

        preauth =
            sign(
                h(
                    < 'preauth',
                      tctx >
                ),
                skt
            )

    in

    [
        StartNormal_G(),

        !TargetCred_G(
            skt,
            pkt,
            certsig
        ),

        !PID_G(pid),

        Fr(~sid),
        Fr(~epoch),
        Fr(~xtsec)
    ]

    --[
        TargetSendP(
            ~sid,
            ~epoch,
            tctx
        )
    ]->

    [
        /*
         * Trusted control-plane authorization.
         * The adversary cannot manufacture this fact.
         */
        Authz_G(
            ~epoch
        ),

        /*
         * Target-local Prepared session.
         */
        TargetPrepared_G(
            ~sid,
            ~epoch,
            pid,
            ~xtsec,
            xtpub,
            tctx
        ),

        /*
         * Epoch need not be confidential.
         */
        Out(~epoch),

        /*
         * Public protocol message P_G.
         */
        Out(
            < 'p_msg',
              'domain_g',
              ~sid,
              xtpub,

              < 'cert_record',
                'domain_g',
                'target',
                pkt,
                certsig >,

              preauth >
        )
    ]



/* ============================================================
   RULE 3
   UAV receives P_G and constructs M1_G

   Checks:
       target certificate
       domain
       target identity
       PreAuth

   Then derives:
       X_U
       next state S_G,1
       transient signing key
       sigma_U

   xusec = x_U
   xupub = X_U
   ============================================================ */

rule UAV_Receive_P_Send_M1:

    let

        certbody =
            h(
                < 'cert',
                  'domain_g',
                  'target',
                  pkt >
            )

        tctx =
            h(
                < 'tctx',
                  'domain_g',
                  sid,
                  pid,
                  'target',
                  epoch,
                  xtpub >
            )

        premsg =
            h(
                < 'preauth',
                  tctx >
            )

        xupub =
            'g' ^ ~xusec

        kg =
            domain_root(
                ku,
                'domain_g'
            )

        /* Single-session model:
           v0 -> v1 */

        cv1 =
            h(
                < 'next',
                  rho0,
                  tctx,
                  xupub,
                  'v1' >
            )

        sk1 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v1',
                    cv1
                )
            )

        pk1 =
            pk(sk1)

        rho1 =
            h(
                < 'state',
                  'domain_g',
                  pid,
                  'v1',
                  cv1,
                  pk1 >
            )

        pd =
            h(
                < 'pending',
                  tctx,
                  rho0,
                  'v1',
                  cv1,
                  pk1 >
            )

        th0 =
            h(
                < 'th0',
                  tctx >
            )

        th1 =
            h(
                < 'th1',
                  th0,
                  xupub,
                  pd >
            )

        sk0 =
            h2s(
                auth_key(
                    kg,
                    pid,
                    'v0',
                    cv0
                )
            )

        sigma =
            sign(
                h(
                    < 'uav_auth',
                      th1 >
                ),
                sk0
            )

    in

    [
        UAVInitial_G(
            cv0,
            pk0,
            rho0
        ),

        !UAVRoot_G(
            ku,
            pid
        ),

        !CA_G(pkca),

        Authz_G(epoch),

        Fr(~xusec),

        In(
            < 'p_msg',
              'domain_g',
              sid,
              xtpub,

              < 'cert_record',
                'domain_g',
                'target',
                pkt,
                certsig >,

              preauth >
        )
    ]

    --[
        /* Verify target certificate */

        _restrict(
            verify(
                certsig,
                certbody,
                pkca
            ) = true
        ),

        /* Verify target PreAuth */

        _restrict(
            verify(
                preauth,
                premsg,
                pkt
            ) = true
        ),

        /* Reconstructed state key must match current PK */

        _restrict(
            pk(sk0) = pk0
        ),

        UAVPreAuthOK(
            sid,
            epoch,
            tctx
        ),

        UAVSendM1(
            sid,
            epoch,
            th1
        )
    ]->

    [
        /*
         * Provisional successor is stored only inside this
         * protocol instance until M2 is accepted.
         */

        UAVWaitM2_G(
            sid,
            epoch,

            rho0,

            cv1,
            pk1,
            rho1,

            pd,
            th1,

            ~xusec,
            xtpub,
            tctx
        ),

        Out(
            < 'm1_msg',
              sid,
              rho0,
              xupub,
              pk1,
              sigma >
        )
    ]



/* ============================================================
   RULE 4
   Target receives M1_G and creates M2_G

   Normal mode only.

       authentication base = CS_G = S_G,0

   After signature verification:
       Z_T
       PRK
       Kcf
       Kcm
       Kapp

   Target creates pending transition before exposing M2.

   IMPORTANT:
   CSInitial_G is consumed here instead of re-emitted.
   This removes a source-cycle from the staging model.
   ============================================================ */

rule Target_Receive_M1_Send_M2:

    let

        cv1 =
            h(
                < 'next',
                  rho0,
                  tctx,
                  xupub,
                  'v1' >
            )

        rho1 =
            h(
                < 'state',
                  'domain_g',
                  pid,
                  'v1',
                  cv1,
                  pk1 >
            )

        pd =
            h(
                < 'pending',
                  tctx,
                  rho0,
                  'v1',
                  cv1,
                  pk1 >
            )

        th0 =
            h(
                < 'th0',
                  tctx >
            )

        th1 =
            h(
                < 'th1',
                  th0,
                  xupub,
                  pd >
            )

        ztarget =
            xupub ^ xtsec

        actx =
            h(
                < 'actx',
                  tctx,
                  rho0 >
            )

        prk =
            hkdf_extract(
                actx,
                ztarget
            )

        kcf =
            hkdf_expand(
                prk,
                h(
                    < 'kconf',
                      th1 >
                )
            )

        kcm =
            hkdf_expand(
                prk,
                h(
                    < 'kcommit',
                      th1 >
                )
            )

        kapp =
            hkdf_expand(
                prk,
                h(
                    < 'appkey',
                      th1 >
                )
            )

        taut =
            mac(
                kcf,
                h(
                    < 'target_confirm',
                      th1 >
                )
            )

        th2 =
            h(
                < 'th2',
                  th1,
                  taut >
            )

    in

    [
        TargetPrepared_G(
            sid,
            epoch,
            pid,
            xtsec,
            xtpub,
            tctx
        ),

        /*
         * Initial committed state.
         * Consumed: no self-loop.
         */
        CSInitial_G(
            cv0,
            pk0,
            rho0
        ),

        In(
            < 'm1_msg',
              sid,
              rho0,
              xupub,
              pk1,
              sigma >
        )
    ]

    --[
        _restrict(
            verify(
                sigma,
                h(
                    < 'uav_auth',
                      th1 >
                ),
                pk0
            ) = true
        ),

        TargetAcceptUAV(
            sid,
            epoch,
            th1
        ),

        TargetSendM2(
            sid,
            epoch,
            kapp
        ),

        SessionKeyTarget(
            sid,
            epoch,
            kapp
        )
    ]->

    [
        /*
         * This single fact represents:
         *
         *   old committed state +
         *   Pi_G +
         *   Sess_G[SID] = AwaitM3
         *
         * in the Normal staging model.
         */

        TargetAwaitCommit_G(
            sid,
            epoch,

            cv1,
            pk1,
            rho1,

            th2,
            kcm,
            kapp
        ),

        Out(
            < 'm2_msg',
              sid,
              taut >
        )
    ]



/* ============================================================
   RULE 5
   UAV receives M2_G, activates S_G,1, sends M3_G

       Z_U = X_T ^ x_U

   With DH algebra:

       X_U ^ x_T = X_T ^ x_U
   ============================================================ */

rule UAV_Receive_M2_Send_M3:

    let

        zuav =
            xtpub ^ xusec

        actx =
            h(
                < 'actx',
                  tctx,
                  rho0 >
            )

        prk =
            hkdf_extract(
                actx,
                zuav
            )

        kcf =
            hkdf_expand(
                prk,
                h(
                    < 'kconf',
                      th1 >
                )
            )

        kcm =
            hkdf_expand(
                prk,
                h(
                    < 'kcommit',
                      th1 >
                )
            )

        kapp =
            hkdf_expand(
                prk,
                h(
                    < 'appkey',
                      th1 >
                )
            )

        expectedtaut =
            mac(
                kcf,
                h(
                    < 'target_confirm',
                      th1 >
                )
            )

        th2 =
            h(
                < 'th2',
                  th1,
                  taut >
            )

        tauc =
            mac(
                kcm,
                h(
                    < 'commit',
                      th2 >
                )
            )

    in

    [
        UAVWaitM2_G(
            sid,
            epoch,

            rho0,

            cv1,
            pk1,
            rho1,

            pd,
            th1,

            xusec,
            xtpub,
            tctx
        ),

        In(
            < 'm2_msg',
              sid,
              taut >
        )
    ]

    --[
        _restrict(
            taut = expectedtaut
        ),

        UAVAcceptTarget(
            sid,
            epoch,
            kapp
        ),

        SessionKeyUAV(
            sid,
            epoch,
            kapp
        ),

        UAVActivate(
            sid,
            epoch,
            rho1
        )
    ]->

    [
        /*
         * Final UAV state for THIS one Normal transaction.
         * It is deliberately not fed into another authentication
         * rule in 01_normal_G.
         */

        UAVActivated_G(
            cv1,
            pk1,
            rho1
        ),

        Out(
            < 'm3_msg',
              sid,
              tauc >
        )
    ]



/* ============================================================
   RULE 6
   Target verifies M3_G and commits the pending state
   ============================================================ */

rule Target_Receive_M3_Commit:

    let

        expectedtauc =
            mac(
                kcm,
                h(
                    < 'commit',
                      th2 >
                )
            )

    in

    [
        TargetAwaitCommit_G(
            sid,
            epoch,

            cv1,
            pk1,
            rho1,

            th2,
            kcm,
            kapp
        ),

        In(
            < 'm3_msg',
              sid,
              tauc >
        )
    ]

    --[
        _restrict(
            tauc = expectedtauc
        ),

        TargetCommit(
            sid,
            epoch,
            kapp,
            rho1
        )
    ]->

    [
        /*
         * Final infrastructure state.
         *
         * Again: no rule feeds this back into another session.
         */

        CSCommittedNext_G(
            cv1,
            pk1,
            rho1
        )
    ]



/* ============================================================
   LEMMA 1
   Executability

   Minimal sanity property:

   There must exist at least one trace reaching TargetCommit.

   TargetCommit can only occur after:
       P -> M1 -> M2 -> M3
   because of the linear state chain above.
   ============================================================ */

lemma executability:
    exists-trace
    "
        Ex sid epoch key rho #i.

            TargetCommit(
                sid,
                epoch,
                key,
                rho
            ) @ i
    "



/* ============================================================
   LEMMA 2
   PreAuth authentication
   ============================================================ */

lemma preauth_authentication:
    "
        All sid epoch tctx #i.

            UAVPreAuthOK(
                sid,
                epoch,
                tctx
            ) @ i

        ==>

            (
                Ex #j.

                    TargetSendP(
                        sid,
                        epoch,
                        tctx
                    ) @ j

                & j < i
            )
    "



/* ============================================================
   LEMMA 3
   UAV authentication
   ============================================================ */

lemma uav_authentication:
    "
        All sid epoch th1 #i.

            TargetAcceptUAV(
                sid,
                epoch,
                th1
            ) @ i

        ==>

            (
                Ex #j.

                    UAVSendM1(
                        sid,
                        epoch,
                        th1
                    ) @ j

                & j < i
            )
    "



/* ============================================================
   LEMMA 4
   Target authentication / explicit key confirmation
   ============================================================ */

lemma target_authentication:
    "
        All sid epoch key #i.

            UAVAcceptTarget(
                sid,
                epoch,
                key
            ) @ i

        ==>

            (
                Ex #j.

                    TargetSendM2(
                        sid,
                        epoch,
                        key
                    ) @ j

                & j < i
            )
    "



/* ============================================================
   LEMMA 5
   Session-key agreement
   ============================================================ */

lemma session_key_agreement:
    "
        All sid epoch key #i.

            SessionKeyUAV(
                sid,
                epoch,
                key
            ) @ i

        ==>

            (
                Ex #j.

                    SessionKeyTarget(
                        sid,
                        epoch,
                        key
                    ) @ j

                & j < i
            )
    "



/* ============================================================
   LEMMA 6
   Session-key secrecy: UAV acceptance
   ============================================================ */

lemma session_key_secrecy_uav:
    "
        All sid epoch key #i.

            SessionKeyUAV(
                sid,
                epoch,
                key
            ) @ i

        ==>

            not (
                Ex #j.
                    K(key) @ j
            )
    "



/* ============================================================
   LEMMA 7
   Session-key secrecy: Target derivation
   ============================================================ */

lemma session_key_secrecy_target:
    "
        All sid epoch key #i.

            SessionKeyTarget(
                sid,
                epoch,
                key
            ) @ i

        ==>

            not (
                Ex #j.
                    K(key) @ j
            )
    "


end
