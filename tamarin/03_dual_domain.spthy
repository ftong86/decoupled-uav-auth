theory UAV_Dual_Domain
begin

/*
  One bounded authentication and state commitment per domain (G and E).
  Public messages are attacker-controlled. The two domains use disjoint
  linear state facts and independent cryptographic domain labels.
  TargetAccept means M1 verification; Commit occurs only after M3.
  The model checks domain-bound provenance and confirmation ordering.
  It does not claim general observational noninterference.
*/

builtins: hashing, signing, diffie-hellman


functions:
    domain_root/2,
    auth_key/4,
    h2s/1,
    hkdf_extract/2,
    hkdf_expand/2,
    mac/2


restriction OnlyOneSetup:
    "All #i #j.
        OnlyOnce() @ i
        & OnlyOnce() @ j
        ==> #i = #j"



/* ============================================================
   RULE 1
   Setup two independently managed domains G and E
   ============================================================ */

rule Setup_Dual_Domain:

    let

        pkcag =
            pk(~skcag)

        pkcae =
            pk(~skcae)

        pktg =
            pk(~sktg)

        pkte =
            pk(~skte)


        kg =
            domain_root(
                ~ku,
                'domain_g'
            )

        ke =
            domain_root(
                ~ku,
                'domain_e'
            )


        skg0 =
            h2s(
                auth_key(
                    kg,
                    ~pidg,
                    'v0',
                    ~cvg0
                )
            )

        pkg0 =
            pk(skg0)

        rhog0 =
            h(
                < 'state',
                  'domain_g',
                  ~pidg,
                  'v0',
                  ~cvg0,
                  pkg0 >
            )


        ske0 =
            h2s(
                auth_key(
                    ke,
                    ~pide,
                    'v0',
                    ~cve0
                )
            )

        pke0 =
            pk(ske0)

        rhoe0 =
            h(
                < 'state',
                  'domain_e',
                  ~pide,
                  'v0',
                  ~cve0,
                  pke0 >
            )


        certbodyg =
            h(
                < 'cert',
                  'domain_g',
                  'target_g',
                  pktg >
            )

        certsigg =
            sign(
                certbodyg,
                ~skcag
            )


        certbodye =
            h(
                < 'cert',
                  'domain_e',
                  'target_e',
                  pkte >
            )

        certsige =
            sign(
                certbodye,
                ~skcae
            )

    in

    [
        Fr(~ku),

        Fr(~pidg),
        Fr(~pide),

        Fr(~cvg0),
        Fr(~cve0),

        Fr(~skcag),
        Fr(~skcae),

        Fr(~sktg),
        Fr(~skte)
    ]

    --[
        OnlyOnce()
    ]->

    [
        !CA_G(pkcag),
        !CA_E(pkcae),

        !TargetCred_G(
            ~sktg,
            pktg,
            certsigg
        ),

        !TargetCred_E(
            ~skte,
            pkte,
            certsige
        ),

        !UAVRoot_G(
            ~ku,
            ~pidg
        ),

        !UAVRoot_E(
            ~ku,
            ~pide
        ),

        !PID_G(~pidg),
        !PID_E(~pide),

        UAV_G0(
            ~cvg0,
            pkg0,
            rhog0
        ),

        UAV_E0(
            ~cve0,
            pke0,
            rhoe0
        ),

        Target_G0(
            ~cvg0,
            pkg0,
            rhog0
        ),

        Target_E0(
            ~cve0,
            pke0,
            rhoe0
        ),

        Start_G(),
        Start_E(),

        Out(pkcag),
        Out(pkcae),
        Out(pktg),
        Out(pkte),
        Out(pkg0),
        Out(pke0)
    ]



/* ============================================================
   G DOMAIN
   ============================================================ */


rule Target_G_Prepare:

    let

        xtpubg = 'g' ^ ~xtg

        ctxg =
            h(
                < 'context',
                  'domain_g',
                  ~sidg,
                  ~epochg,
                  ~challengeg,
                  xtpubg >
            )

        preauthg =
            sign(
                h(
                    < 'preauth',
                      'domain_g',
                      ctxg,
                      xtpubg >
                ),
                sktg
            )

    in

    [
        Start_G(),

        !TargetCred_G(
            sktg,
            pktg,
            certsigg
        ),

        Fr(~sidg),
        Fr(~epochg),
        Fr(~challengeg),
        Fr(~xtg)
    ]

    --[
        TargetPrepareG(
            ~sidg,
            ~epochg,
            ctxg
        )
    ]->

    [
        GAuthz(
            ~epochg
        ),

        GPrepared(
            ~sidg,
            ~epochg,
            ctxg,
            xtpubg,
            ~xtg
        ),

        Out(
            < 'p_g',
              'domain_g',
              ~sidg,
              ~epochg,
              ctxg,
              xtpubg,

              < 'cert_g',
                'domain_g',
                'target_g',
                pktg,
                certsigg >,

              preauthg >
        )
    ]



rule UAV_G_Send_M1:

    let

        xupubg = 'g' ^ ~xug

        certbodyg =
            h(
                < 'cert',
                  'domain_g',
                  'target_g',
                  pktg >
            )

        kg =
            domain_root(
                ku,
                'domain_g'
            )

        skg0 =
            h2s(
                auth_key(
                    kg,
                    pidg,
                    'v0',
                    cvg0
                )
            )

        cvg1 =
            h(
                < 'next',
                  'domain_g',
                  rhog0,
                  ctxg,
                  ~freshg >
            )

        skg1 =
            h2s(
                auth_key(
                    kg,
                    pidg,
                    'v1',
                    cvg1
                )
            )

        pkg1 =
            pk(skg1)

        rhog1 =
            h(
                < 'state',
                  'domain_g',
                  pidg,
                  'v1',
                  cvg1,
                  pkg1 >
            )

        authg =
            h(
                < 'uav_auth',
                  'domain_g',
                  sidg,
                  epochg,
                  ctxg,
                  xupubg,
                  rhog0,
                  rhog1,
                  pkg1 >
            )

        sigg =
            sign(
                authg,
                skg0
            )

    in

    [
        UAV_G0(
            cvg0,
            pkg0,
            rhog0
        ),

        !UAVRoot_G(
            ku,
            pidg
        ),

        !CA_G(pkcag),

        GAuthz(epochg),

        Fr(~freshg),
        Fr(~xug),

        In(
            < 'p_g',
              'domain_g',
              sidg,
              epochg,
              ctxg,
              xtpubg,

              < 'cert_g',
                'domain_g',
                'target_g',
                pktg,
                certsigg >,

              preauthg >
        )
    ]

    --[
        _restrict(
            verify(
                certsigg,
                certbodyg,
                pkcag
            ) = true
        ),

        _restrict(
            verify(
                preauthg,
                h(
                    < 'preauth',
                      'domain_g',
                      ctxg,
                      xtpubg >
                ),
                pktg
            ) = true
        ),

        _restrict(
            pk(skg0) = pkg0
        ),

        UAVSendG(
            sidg,
            epochg,
            ctxg,
            rhog1
        )
    ]->

    [
        UAVWaitM2G(
            sidg, epochg, ctxg, rhog1,
            cvg1, pkg1, xtpubg, ~xug
        ),

        Out(
            < 'm1_g',
              'domain_g',
              sidg,
              epochg,
              ctxg,
              xupubg,
              rhog0,
              cvg1,
              pkg1,
              rhog1,
              sigg >
        )
    ]



rule Target_G_Accept:

    let
        authg = h(
            < 'uav_auth', 'domain_g', sidg, epochg, ctxg,
              xupubg, rhog0, rhog1, pkg1 >
        )
        zg = xupubg ^ xtg
        prkg = hkdf_extract(ctxg, zg)
        kcfg = hkdf_expand(prkg, h(< 'confirm', 'domain_g', ctxg, rhog1 >))
        kcmg = hkdf_expand(prkg, h(< 'commit_key', 'domain_g', ctxg, rhog1 >))
        taug = mac(kcfg, h(< 'target_confirm', 'domain_g', sidg, epochg, ctxg, rhog1 >))

    in
    [
        Target_G0(cvg0, pkg0, rhog0),
        GPrepared(sidg, epochg, ctxg, xtpubg, xtg),
        In(< 'm1_g', 'domain_g', sidg, epochg, ctxg,
             xupubg, rhog0, cvg1, pkg1, rhog1, sigg >)
    ]
    --[
        _restrict(verify(sigg, authg, pkg0) = true),
        TargetAcceptG(sidg, epochg, ctxg, rhog1)
    ]->
    [
        GAwaitM3(sidg, epochg, ctxg, cvg1,
                       pkg1, rhog1, kcmg, taug),
        Out(< 'm2_g', 'domain_g', sidg, epochg,
              ctxg, rhog1, taug >)
    ]


/* The UAV verifies ECDH-derived target confirmation before activating its state. */
rule UAV_G_Verify_M2_Send_M3:

    let
        zg = xtpubg ^ xug
        prkg = hkdf_extract(ctxg, zg)
        kcfg = hkdf_expand(prkg, h(< 'confirm', 'domain_g', ctxg, rhog1 >))
        kcmg = hkdf_expand(prkg, h(< 'commit_key', 'domain_g', ctxg, rhog1 >))
        expectedtaug = mac(kcfg, h(< 'target_confirm', 'domain_g', sidg, epochg, ctxg, rhog1 >))
        commitg = mac(kcmg, h(< 'commit', 'domain_g', sidg, epochg, ctxg, rhog1, taug >))

    in
    [
        UAVWaitM2G(sidg, epochg, ctxg, rhog1,
                        cvg1, pkg1, xtpubg, xug),
        In(< 'm2_g', 'domain_g', sidg, epochg,
             ctxg, rhog1, taug >)
    ]
    --[
        _restrict(taug = expectedtaug),
        UAVConfirmG(sidg, epochg, ctxg, rhog1)
    ]->
    [
        UAV_GActivated(cvg1, pkg1, rhog1),
        Out(< 'm3_g', 'domain_g', sidg, epochg,
              ctxg, rhog1, commitg >)
    ]


/* State commitment occurs only after authenticated M3 verification. */
rule Target_G_Commit:

    let
        expectedcommitg = mac(kcmg, h(< 'commit', 'domain_g', sidg, epochg,
                                             ctxg, rhog1, taug >))

    in
    [
        GAwaitM3(sidg, epochg, ctxg, cvg1,
                       pkg1, rhog1, kcmg, taug),
        In(< 'm3_g', 'domain_g', sidg, epochg,
             ctxg, rhog1, taucg >)
    ]
    --[
        _restrict(taucg = expectedcommitg),
        CommitG(sidg, epochg, ctxg, rhog1)
    ]->
    [
        GCommitted(cvg1, pkg1, rhog1)
    ]


/* ============================================================
   E DOMAIN
   ============================================================ */


rule Target_E_Prepare:

    let

        xtpube = 'g' ^ ~xte

        ctxe =
            h(
                < 'context',
                  'domain_e',
                  ~side,
                  ~epoche,
                  ~challengee,
                  xtpube >
            )

        preauthe =
            sign(
                h(
                    < 'preauth',
                      'domain_e',
                      ctxe,
                      xtpube >
                ),
                skte
            )

    in

    [
        Start_E(),

        !TargetCred_E(
            skte,
            pkte,
            certsige
        ),

        Fr(~side),
        Fr(~epoche),
        Fr(~challengee),
        Fr(~xte)
    ]

    --[
        TargetPrepareE(
            ~side,
            ~epoche,
            ctxe
        )
    ]->

    [
        EAuthz(
            ~epoche
        ),

        EPrepared(
            ~side,
            ~epoche,
            ctxe,
            xtpube,
            ~xte
        ),

        Out(
            < 'p_e',
              'domain_e',
              ~side,
              ~epoche,
              ctxe,
              xtpube,

              < 'cert_e',
                'domain_e',
                'target_e',
                pkte,
                certsige >,

              preauthe >
        )
    ]



rule UAV_E_Send_M1:

    let

        xupube = 'g' ^ ~xue

        certbodye =
            h(
                < 'cert',
                  'domain_e',
                  'target_e',
                  pkte >
            )

        ke =
            domain_root(
                ku,
                'domain_e'
            )

        ske0 =
            h2s(
                auth_key(
                    ke,
                    pide,
                    'v0',
                    cve0
                )
            )

        cve1 =
            h(
                < 'next',
                  'domain_e',
                  rhoe0,
                  ctxe,
                  ~freshe >
            )

        ske1 =
            h2s(
                auth_key(
                    ke,
                    pide,
                    'v1',
                    cve1
                )
            )

        pke1 =
            pk(ske1)

        rhoe1 =
            h(
                < 'state',
                  'domain_e',
                  pide,
                  'v1',
                  cve1,
                  pke1 >
            )

        authe =
            h(
                < 'uav_auth',
                  'domain_e',
                  side,
                  epoche,
                  ctxe,
                  xupube,
                  rhoe0,
                  rhoe1,
                  pke1 >
            )

        sige =
            sign(
                authe,
                ske0
            )

    in

    [
        UAV_E0(
            cve0,
            pke0,
            rhoe0
        ),

        !UAVRoot_E(
            ku,
            pide
        ),

        !CA_E(pkcae),

        EAuthz(epoche),

        Fr(~freshe),
        Fr(~xue),

        In(
            < 'p_e',
              'domain_e',
              side,
              epoche,
              ctxe,
              xtpube,

              < 'cert_e',
                'domain_e',
                'target_e',
                pkte,
                certsige >,

              preauthe >
        )
    ]

    --[
        _restrict(
            verify(
                certsige,
                certbodye,
                pkcae
            ) = true
        ),

        _restrict(
            verify(
                preauthe,
                h(
                    < 'preauth',
                      'domain_e',
                      ctxe,
                      xtpube >
                ),
                pkte
            ) = true
        ),

        _restrict(
            pk(ske0) = pke0
        ),

        UAVSendE(
            side,
            epoche,
            ctxe,
            rhoe1
        )
    ]->

    [
        UAVWaitM2E(
            side, epoche, ctxe, rhoe1,
            cve1, pke1, xtpube, ~xue
        ),

        Out(
            < 'm1_e',
              'domain_e',
              side,
              epoche,
              ctxe,
              xupube,
              rhoe0,
              cve1,
              pke1,
              rhoe1,
              sige >
        )
    ]



rule Target_E_Accept:

    let
        authe = h(
            < 'uav_auth', 'domain_e', side, epoche, ctxe,
              xupube, rhoe0, rhoe1, pke1 >
        )
        ze = xupube ^ xte
        prke = hkdf_extract(ctxe, ze)
        kcfe = hkdf_expand(prke, h(< 'confirm', 'domain_e', ctxe, rhoe1 >))
        kcme = hkdf_expand(prke, h(< 'commit_key', 'domain_e', ctxe, rhoe1 >))
        taue = mac(kcfe, h(< 'target_confirm', 'domain_e', side, epoche, ctxe, rhoe1 >))

    in
    [
        Target_E0(cve0, pke0, rhoe0),
        EPrepared(side, epoche, ctxe, xtpube, xte),
        In(< 'm1_e', 'domain_e', side, epoche, ctxe,
             xupube, rhoe0, cve1, pke1, rhoe1, sige >)
    ]
    --[
        _restrict(verify(sige, authe, pke0) = true),
        TargetAcceptE(side, epoche, ctxe, rhoe1)
    ]->
    [
        EAwaitM3(side, epoche, ctxe, cve1,
                       pke1, rhoe1, kcme, taue),
        Out(< 'm2_e', 'domain_e', side, epoche,
              ctxe, rhoe1, taue >)
    ]


/* The UAV verifies ECDH-derived target confirmation before activating its state. */
rule UAV_E_Verify_M2_Send_M3:

    let
        ze = xtpube ^ xue
        prke = hkdf_extract(ctxe, ze)
        kcfe = hkdf_expand(prke, h(< 'confirm', 'domain_e', ctxe, rhoe1 >))
        kcme = hkdf_expand(prke, h(< 'commit_key', 'domain_e', ctxe, rhoe1 >))
        expectedtaue = mac(kcfe, h(< 'target_confirm', 'domain_e', side, epoche, ctxe, rhoe1 >))
        commite = mac(kcme, h(< 'commit', 'domain_e', side, epoche, ctxe, rhoe1, taue >))

    in
    [
        UAVWaitM2E(side, epoche, ctxe, rhoe1,
                        cve1, pke1, xtpube, xue),
        In(< 'm2_e', 'domain_e', side, epoche,
             ctxe, rhoe1, taue >)
    ]
    --[
        _restrict(taue = expectedtaue),
        UAVConfirmE(side, epoche, ctxe, rhoe1)
    ]->
    [
        UAV_EActivated(cve1, pke1, rhoe1),
        Out(< 'm3_e', 'domain_e', side, epoche,
              ctxe, rhoe1, commite >)
    ]


/* State commitment occurs only after authenticated M3 verification. */
rule Target_E_Commit:

    let
        expectedcommite = mac(kcme, h(< 'commit', 'domain_e', side, epoche,
                                             ctxe, rhoe1, taue >))

    in
    [
        EAwaitM3(side, epoche, ctxe, cve1,
                       pke1, rhoe1, kcme, taue),
        In(< 'm3_e', 'domain_e', side, epoche,
             ctxe, rhoe1, tauce >)
    ]
    --[
        _restrict(tauce = expectedcommite),
        CommitE(side, epoche, ctxe, rhoe1)
    ]->
    [
        ECommitted(cve1, pke1, rhoe1)
    ]


/* ============================================================
   LEMMAS
   ============================================================ */


/*
 * Both domains can complete honestly in the same trace.
 */

lemma dual_domain_executable:
    exists-trace
    "
        Ex sidg eg ctxg rhog
           side ee ctxe rhoe
           #i #j.

            CommitG(
                sidg,
                eg,
                ctxg,
                rhog
            ) @ i

          &

            CommitE(
                side,
                ee,
                ctxe,
                rhoe
            ) @ j
    "



/*
 * Any accepted G-domain authentication must originate
 * from a genuine G-domain UAV authentication.
 *
 * Since the adversary controls the public network, this also
 * excludes an E-domain M1 from being accepted as G.
 */

lemma g_accept_requires_g_origin:
    "
        All sid epoch ctx rho #i.

            TargetAcceptG(
                sid,
                epoch,
                ctx,
                rho
            ) @ i

        ==>

            (
                Ex #j.

                    UAVSendG(
                        sid,
                        epoch,
                        ctx,
                        rho
                    ) @ j

                & j < i
            )
    "



/*
 * Symmetric E-domain isolation.
 */

lemma e_accept_requires_e_origin:
    "
        All sid epoch ctx rho #i.

            TargetAcceptE(
                sid,
                epoch,
                ctx,
                rho
            ) @ i

        ==>

            (
                Ex #j.

                    UAVSendE(
                        sid,
                        epoch,
                        ctx,
                        rho
                    ) @ j

                & j < i
            )
    "



/*
 * G state advancement requires a genuine G authentication.
 */

lemma g_commit_requires_g_origin:
    "
        All sid epoch ctx rho #i.

            CommitG(
                sid,
                epoch,
                ctx,
                rho
            ) @ i

        ==>

            (
                Ex #j.

                    UAVSendG(
                        sid,
                        epoch,
                        ctx,
                        rho
                    ) @ j

                & j < i
            )
    "



/*
 * E state advancement requires a genuine E authentication.
 */

lemma e_commit_requires_e_origin:
    "
        All sid epoch ctx rho #i.

            CommitE(
                sid,
                epoch,
                ctx,
                rho
            ) @ i

        ==>

            (
                Ex #j.

                    UAVSendE(
                        sid,
                        epoch,
                        ctx,
                        rho
                    ) @ j

                & j < i
            )
    "



/*
 * A concrete G authentication record cannot simultaneously
 * be accepted as an E authentication record.
 */

lemma no_g_to_e_acceptance:
    "
        not (
            Ex sid epoch ctx rho #i #j.

                UAVSendG(
                    sid,
                    epoch,
                    ctx,
                    rho
                ) @ i

              &

                TargetAcceptE(
                    sid,
                    epoch,
                    ctx,
                    rho
                ) @ j
        )
    "



/*
 * Symmetric direction.
 */

lemma no_e_to_g_acceptance:
    "
        not (
            Ex sid epoch ctx rho #i #j.

                UAVSendE(
                    sid,
                    epoch,
                    ctx,
                    rho
                ) @ i

              &

                TargetAcceptG(
                    sid,
                    epoch,
                    ctx,
                    rho
                ) @ j
        )
    "



/* Domain-specific commits require that the UAV confirmed the matching M2. */
lemma g_commit_requires_g_confirmation:
    "All sid epoch ctx rho #i.
        CommitG(sid,epoch,ctx,rho) @ #i
        ==>
        (Ex #j. UAVConfirmG(sid,epoch,ctx,rho) @ #j & #j < #i)"

lemma e_commit_requires_e_confirmation:
    "All sid epoch ctx rho #i.
        CommitE(sid,epoch,ctx,rho) @ #i
        ==>
        (Ex #j. UAVConfirmE(sid,epoch,ctx,rho) @ #j & #j < #i)"

end
