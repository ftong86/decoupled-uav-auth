# Keep shell scripts and Makefiles with Unix line endings so they run in WSL/Linux.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.spthy text eol=lf
Makefile text eol=lf
*.patch text eol=lf
*.diff text eol=lf
CMakeLists.txt text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.json text eol=lf
*.md text eol=lf
